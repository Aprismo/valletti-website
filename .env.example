# Environment variables for the Valletti website.
# Locally: copy to .env.local and fill in. On Vercel: add the same names
# under Project → Settings → Environment Variables (Production).
# Leave the Supabase/Resend values empty locally to run on the
# placeholder data in /data (admin changes then stay in your browser).

# ── Supabase (required in production) ───────────────────────────────
# Supabase → Project Settings → API (Data API / API Keys).
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" key (or the newer "publishable" key, sb_publishable_…).
# Never put the service_role / secret key here — it is not needed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Resend — contact / visit form (required in production) ──────────
# Resend → API Keys (sending access is enough).
RESEND_API_KEY=
# Inbox that receives visit requests and questions. Comma-separate for
# several. Roberto confirmed info@vallettigiacinto.it earlier.
CONTACT_NOTIFY_EMAIL=
# Sender address on a domain verified in Resend → Domains, e.g.
# "Valletti website <noreply@example-domain.it>".
CONTACT_FROM_EMAIL=
